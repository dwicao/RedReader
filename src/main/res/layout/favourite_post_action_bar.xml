<LinearLayout
		xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:tools="http://schemas.android.com/tools"
		android:id="@+id/fav_action_bar"
		android:layout_width="match_parent"
		android:layout_height="36dp"
		android:orientation="horizontal"
		android:baselineAligned="false">

	<LinearLayout
			android:id="@+id/fav_vote_button"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center"
			android:orientation="horizontal"
			android:clickable="true"
			android:focusable="true"
			android:background="@drawable/rr_postlist_commentbutton_selector_main">

		<ImageView
				android:id="@+id/fav_vote_icon"
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:src="?rrIconArrowUpBold"
				android:scaleType="fitCenter"
				android:contentDescription="@string/action_upvote"/>

		<com.google.android.material.textview.MaterialTextView
				android:id="@+id/fav_vote_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="4dp"
				android:gravity="center"
				android:textSize="11sp"
				android:textColor="?rrPostCommentsButtonTextCol"
				tools:ignore="SmallSp"/>

	</LinearLayout>

	<LinearLayout
			android:id="@+id/fav_comments_button"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center"
			android:orientation="horizontal"
			android:clickable="true"
			android:focusable="true"
			android:background="@drawable/rr_postlist_commentbutton_selector_main">

		<ImageView
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:src="?rrIconComments"
				android:scaleType="fitCenter"
				android:contentDescription="@string/action_comments"/>

		<com.google.android.material.textview.MaterialTextView
				android:id="@+id/fav_comments_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="4dp"
				android:gravity="center"
				android:textSize="11sp"
				android:textColor="?rrPostCommentsButtonTextCol"
				tools:ignore="SmallSp"/>

	</LinearLayout>

</LinearLayout>
